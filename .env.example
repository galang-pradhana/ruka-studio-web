# Prisma Database Connection
# Replace with your production/live database URL (e.g. from Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# NextAuth Configuration
# Generate a random string: `openssl rand -base64 32`
NEXTAUTH_SECRET="your-nextauth-secret-key"
# Your production URL in Vercel (e.g., https://your-project.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# AI/API Keys
TAVILY_API_KEY="your-tavily-api-key"

# Cloudflare R2 Storage (untuk brand assets)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="brand-assets"
R2_S3_ENDPOINT="https://<your-r2-account-id>.r2.cloudflarestorage.com"
R2_PUBLIC_URL="https://your-custom-cdn-domain.com/"
