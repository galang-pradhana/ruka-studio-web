generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

enum ProjectMode {
  CONSULTATION
  FULL_CONTRACTOR
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PENDING
  CANCELLED
}

enum TermStatus {
  UNPAID
  PAID
}

enum ExpenseCategory {
  TRANSPORT
  PRINT
  SOFTWARE
  MATERIAL
  LABOR
  EQUIPMENT
  OTHER
}

enum LpSection {
  HERO
  SERVICE
  PORTFOLIO
  TESTIMONIAL
  CONTACT
  WHY_US
  OUR_TEAM
  PHILOSOPHY
  ABOUT_HERO
  PROCESS
  FAQ
  PROJECT_BRIEF
  FOOTER
}

model User {
  id                   String            @id @default(uuid())
  name                 String            @db.VarChar(100)
  email                String            @unique @db.VarChar(255)
  passwordHash         String            @map("password_hash") @db.Text
  role                 Role
  isActive             Boolean           @default(true) @map("is_active")
  mustChangePassword   Boolean           @default(true) @map("must_change_password")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relations
  projects             Project[]         @relation("ProjectCreator")
  expenses             ProjectExpense[]  @relation("ExpenseCreator")
  incomes              ProjectIncome[]   @relation("IncomeCreator")
  lpContents           LpContent[]       @relation("ContentUpdater")

  @@map("users")
}

model Project {
  id               String            @id @default(uuid())
  name             String            @db.VarChar(200)
  clientName       String            @map("client_name") @db.VarChar(150)
  location         String?           @db.Text
  contractValue    Decimal?          @map("contract_value") @db.Decimal(15, 2)
  mode             ProjectMode
  status           ProjectStatus
  startDate        DateTime?         @map("start_date") @db.Date
  estimatedEndDate DateTime?         @map("estimated_end_date") @db.Date
  actualEndDate    DateTime?         @map("actual_end_date") @db.Date
  notes            String?           @db.Text
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")

  // Relations
  creator          User              @relation("ProjectCreator", fields: [createdBy], references: [id])
  terms            ProjectTerm[]
  expenses         ProjectExpense[]
  incomes          ProjectIncome[]

  @@map("projects")
}

model ProjectTerm {
  id          String     @id @default(uuid())
  projectId   String     @map("project_id")
  termName    String     @map("term_name") @db.VarChar(100)
  percentage  Decimal?   @db.Decimal(5, 2)
  amount      Decimal    @db.Decimal(15, 2)
  dueDate     DateTime?  @map("due_date") @db.Date
  paidDate    DateTime?  @map("paid_date") @db.Date
  status      TermStatus
  notes       String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_terms")
}

model ProjectExpense {
  id          String          @id @default(uuid())
  projectId   String          @map("project_id")
  category    ExpenseCategory
  description String          @db.Text
  amount      Decimal         @db.Decimal(15, 2)
  expenseDate DateTime        @map("expense_date") @db.Date
  receiptUrl  String?         @map("receipt_url") @db.Text
  createdBy   String          @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")

  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User            @relation("ExpenseCreator", fields: [createdBy], references: [id])

  @@map("project_expenses")
}

model ProjectIncome {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  description String   @db.Text
  amount      Decimal  @db.Decimal(15, 2)
  incomeDate  DateTime @map("income_date") @db.Date
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator     User     @relation("IncomeCreator", fields: [createdBy], references: [id])

  @@map("project_incomes")
}

model LpContent {
  id         String     @id @default(uuid())
  section    LpSection
  key        String     @db.VarChar(100)
  value      String     @db.Text
  orderIndex Int?       @map("order_index")
  isActive   Boolean    @default(true) @map("is_active")
  updatedBy  String     @map("updated_by")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")

  updater    User       @relation("ContentUpdater", fields: [updatedBy], references: [id])

  @@map("lp_contents")
}

model LpPortfolioItem {
  id               String   @id @default(uuid())
  title            String   @db.VarChar(500)
  description      String?  @db.Text
  imageUrl         String   @map("image_url") @db.Text
  projectType      String?  @map("project_type") @db.VarChar(300)
  detailImagesJson String?  @map("detail_images_json") @db.Text
  orderIndex       Int?     @map("order_index")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("lp_portfolio_items")
}

model ProjectBrief {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(200)
  email     String   @db.VarChar(255)
  location  String   @db.VarChar(200)
  propType  String   @map("prop_type") @db.VarChar(200)
  landSize  String   @map("land_size") @db.VarChar(100)
  budget    String   @db.VarChar(100)
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("project_briefs")
}

